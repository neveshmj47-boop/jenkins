pipeline{
agent any
stages{
	stage('clone'){
		steps{
			echo "code clones"
		}
	}
	stage('Build'){
                steps{
			sh 'mkdir -p build'
                        sh 'echo build successfull > build/result.txt'
                }
        }	
	stage('Test'){
                steps{
                        echo "Testing"
                }
        }
	stage('Deploy'){
                steps{
                        echo "Deploy completed"
                }
        }
	}
	}


